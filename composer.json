{
  "name": "christophlehmann/httpbasicauth",
  "description": "HTTP Basic Auth for TYPO3 12+",
  "type": "typo3-cms-extension",
  "license": [
    "GPL-2.0-or-later"
  ],
  "keywords": [
    "authentication"
  ],
  "support": {
    "issues": "https://github.com/christophlehmann/httpbasicauth"
  },
  "authors": [
    {
      "name": "Christoph Lehmann",
      "email": "post@christophlehmann.eu"
    }
  ],
  "require": {
    "php": ">=8.0",
    "typo3/cms-core": "^12.0 || 13.0"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "httpbasicauth"
    }
  },
  "autoload": {
    "psr-4": {
      "Lemming\\Httpbasicauth\\": "Classes/"
    }
  }
}
